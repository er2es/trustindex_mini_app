{% extends 'base.html.twig' %}

{% block title %}Cégek statisztikája – Trustindex{% endblock %}

{% block body %}
<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h4 fw-bold mb-1">Cégek statisztikája</h1>
            <p class="text-muted small mb-0">{{ total }} cég – átlagos értékelés szerint csökkenő sorrendben</p>
        </div>
    </div>

    {% if stats is empty %}
        <div class="text-center py-5 text-muted">
            <i class="bi bi-building fs-1 d-block mb-3"></i>
            <p>Még nincs értékelt cég.</p>
            <a href="{{ path('review_new') }}" class="btn btn-ti btn-sm px-4">Első vélemény írása</a>
        </div>
    {% else %}
        <div class="row g-3">
            {% for stat in stats %}
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 p-4">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <h2 class="h6 fw-bold mb-0 text-truncate">{{ stat.companyName }}</h2>
                            <a href="{{ path('company_reviews', {id: stat.companyId}) }}"
                               class="badge rounded-pill text-bg-light text-muted flex-shrink-0 text-decoration-none"><u>{{ stat.reviewCount }} db</u></a>
                        </div>

                        <div class="stars fs-4 my-2">
                            {% set fullStars = stat.averageRating|round(0, 'floor') %}
                            {% for i in 1..5 %}
                                <span style="color: {{ i <= fullStars ? 'var(--ti-star)' : '#ddd' }};">★</span>
                            {% endfor %}
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold fs-5" style="color: var(--ti-green);">{{ stat.averageRating|number_format(2, '.') }}</span>
                            <span class="text-muted small">/ 5.00 átlag</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if totalPages > 1 %}
            {% include 'review/_pagination.html.twig' with {
                page: page,
                totalPages: totalPages
            } %}
        {% endif %}
    {% endif %}

</div>
{% endblock %}
