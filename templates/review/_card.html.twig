<article class="card h-100" data-review-id="{{ review.id }}">
    <div class="card-body d-flex flex-column">

        {# Fejléc: avatar + cég + csillagok #}
        <div class="d-flex align-items-start gap-3 mb-3">
            <div class="review-avatar flex-shrink-0">
                {{ review.authorEmail|slice(0,2)|upper }}
            </div>
            <div class="flex-grow-1 min-w-0">
                <div class="fw-bold text-truncate">{{ review.companyName }}</div>
                <div class="text-muted small">{{ review.createdAt|date('Y.m.d') }}</div>
            </div>
            <div class="stars fs-5 flex-shrink-0">
                {% for i in 1..5 %}
                    <span>{{ i <= review.rating ? '★' : '☆' }}</span>
                {% endfor %}
            </div>
        </div>

        <hr class="my-2">

        {# Szöveg – 100 karakter, |slice mb-safe (mb_substr alatt) #}
        <p class="flex-grow-1 text-muted small mb-3">
            {%- if review.reviewText|length > 100 -%}
                {{- review.reviewText|slice(0, 100) -}}&hellip;
            {%- else -%}
                {{- review.reviewText -}}
            {%- endif -%}
        </p>

        {# Lábléc: reakciók + bővebben #}
        <div class="d-flex align-items-center justify-content-between mt-auto">
            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary rounded-pill px-3 card-reaction-btn"
                        data-review-id="{{ review.id }}"
                        data-type="like"
                        style="font-size:.8rem;">
                    <i class="bi bi-hand-thumbs-up me-1"></i><span class="reaction-like-count">{{ review.likeCount }}</span>
                </button>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary rounded-pill px-3 card-reaction-btn"
                        data-review-id="{{ review.id }}"
                        data-type="dislike"
                        style="font-size:.8rem;">
                    <i class="bi bi-hand-thumbs-down me-1"></i><span class="reaction-dislike-count">{{ review.dislikeCount }}</span>
                </button>
            </div>
            <a href="{{ path('review_show', {id: review.id}) }}" class="btn btn-outline-ti btn-sm rounded-pill px-3" style="font-size:.8rem;">
                Bővebben
            </a>
        </div>

    </div>
</article>
