{% extends 'base.html.twig' %}

{% block title %}Vélemények – Trustindex{% endblock %}

{% block body %}
<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h4 fw-bold mb-1">Ügyfélvélemények</h1>
            <p class="text-muted small mb-0" id="result-count">{{ reviews|length }} vélemény</p>
        </div>
        <a href="{{ path('review_new') }}" class="btn btn-ti px-4">
            <i class="bi bi-plus-lg me-1"></i>Vélemény írása
        </a>
    </div>

    {# Kereső #}
    <form method="get" action="{{ path('review_index') }}" class="card p-3 mb-4" id="search-form">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text"
                           name="q"
                           value="{{ query }}"
                           placeholder="Keresés cégek és vélemények között..."
                           class="form-control border-start-0 ps-0"
                           id="search-input">
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-ti px-3">Keresés</button>
                {% if query %}
                    <a href="{{ path('review_index') }}" class="btn btn-outline-secondary px-3 ms-1">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </div>
        </div>
        <div class="mt-2 ms-1">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="includeText" id="includeText" value="1"
                       {{ includeText ? 'checked' : '' }}>
                <label class="form-check-label small text-muted" for="includeText">
                    Keresés vélemény szövegében is
                </label>
            </div>
        </div>
    </form>

    {# Lista (AJAX-frissíthető) #}
    <div id="review-list-wrapper">
        {% include 'review/_list.html.twig' with {reviews: reviews, query: query} %}
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    const form = document.getElementById('search-form');
    const wrapper = document.getElementById('review-list-wrapper');
    const counter = document.getElementById('result-count');
    let currentQuery = '';

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        const params = new URLSearchParams(new FormData(form));
        const url = form.action + '?' + params.toString();

        // Update URL without reload
        history.pushState({}, '', url);

        currentQuery = params.get('q') || '';

        try {
            const res = await fetch(url, {
                headers: {'X-Requested-With': 'XMLHttpRequest'},
            });
            if (!res.ok) throw new Error();
            const data = await res.json();
            wrapper.innerHTML = data.html;
            counter.textContent = data.count + ' vélemény';
        } catch {
            showToast('Hiba a keresés során.', 'error');
        }
    });

    // Browser back/forward
    window.addEventListener('popstate', () => form.requestSubmit());
})();
</script>
{% endblock %}
