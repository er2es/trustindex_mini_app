{% if totalPages > 1 %}
{% set start = max(1, page - 1) %}
{% set end   = min(totalPages, page + 1) %}
{% if end - start < 2 %}
    {% if start == 1 %}
        {% set end = min(totalPages, 3) %}
    {% else %}
        {% set start = max(1, end - 2) %}
    {% endif %}
{% endif %}

<nav class="mt-4 d-flex justify-content-center" aria-label="Lapozó">
    <ul class="pagination pagination-sm mb-0">

        {# Előző #}
        <li class="page-item {{ page <= 1 ? 'disabled' }}">
            <a class="page-link rounded-pill me-1 pagination-link"
               href="?page={{ page - 1 }}" data-page="{{ page - 1 }}"
               aria-label="Előző">‹</a>
        </li>

        {# Első oldal ha nem látszik #}
        {% if start > 1 %}
            <li class="page-item">
                <a class="page-link rounded-pill me-1 pagination-link" href="?page=1" data-page="1">1</a>
            </li>
            {% if start > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
        {% endif %}

        {# Max 3 oldalszám #}
        {% for p in start..end %}
            <li class="page-item {{ p == page ? 'active' }}">
                <a class="page-link rounded-pill me-1 pagination-link" href="?page={{ p }}" data-page="{{ p }}">{{ p }}</a>
            </li>
        {% endfor %}

        {# Utolsó oldal ha nem látszik #}
        {% if end < totalPages %}
            {% if end < totalPages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
            <li class="page-item">
                <a class="page-link rounded-pill me-1 pagination-link" href="?page={{ totalPages }}" data-page="{{ totalPages }}">{{ totalPages }}</a>
            </li>
        {% endif %}

        {# Következő #}
        <li class="page-item {{ page >= totalPages ? 'disabled' }}">
            <a class="page-link rounded-pill pagination-link"
               href="?page={{ page + 1 }}" data-page="{{ page + 1 }}"
               aria-label="Következő">›</a>
        </li>

    </ul>
</nav>
{% endif %}
